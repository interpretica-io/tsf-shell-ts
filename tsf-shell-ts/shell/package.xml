<?xml version="1.0" ?>
<package version="1.0">
    <description>Terminal emulator</description>
    <author mailto="maxim.menshikov@interpretica.io" />
    <session track_conf="silent">
        <prologue><script name="prologue"><objective>Prepare the shell group.</objective></script></prologue>
        <epilogue><script name="epilogue"><objective>Finalize the shell group.</objective></script></epilogue>
        <run>
            <script name="render"><objective>Paint a known screen and read the text back.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="cursor"><objective>Cursor positioning is reported correctly.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="attrs"><objective>Cell colours and attributes from SGR sequences.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="expect"><objective>Interactive expect on the stream and the screen.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="resize"><objective>Resize reaches the child (stty size) and the screen.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="wait"><objective>A spawned program's exit status.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="conformance"><objective>A fixed escape script rendered to a golden grid.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="erase"><objective>Erase-in-line and erase-in-display clear named cells.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="scroll"><objective>A scrolling region (DECSTBM) confines scrolling.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="edit"><objective>Insert/delete-character rearrange a row.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="tabs"><objective>Default and custom horizontal tab stops.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="wrap"><objective>Autowrap carries text onto the next row.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="cbtwrap"><objective>A back-tab from the last column cancels the pending wrap.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="altscreen"><objective>The alternate screen buffer swaps out and back.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="unicode"><objective>UTF-8 decoding and wide-glyph handling.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="savecursor"><objective>Save-cursor and restore-cursor (DECSC/DECRC).</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="color"><objective>24-bit direct colour and 256-colour palette index.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="cursorvis"><objective>Cursor-visibility mode (DECTCEM) is tracked.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="keys"><objective>Symbolic keys become the right byte sequences.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="signals"><objective>Control keys are turned into signals.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="scrollback"><objective>Lines scrolled off the top are kept.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="rowattrs"><objective>Per-cell attribute records for a whole row.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="regex"><objective>Regex expect matches, and absent patterns time out.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="multisession"><objective>Concurrent sessions stay isolated.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
        <run>
            <script name="chunking"><objective>A terminal looks the same however its input is cut into writes.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
            <arg name="seq">
                <value>wrap_pending</value>
                <value>cub_pending</value>
                <value>cr_pending</value>
                <value>cha_pending</value>
                <value>bs_pending</value>
                <value>cbt_pending</value>
                <value>ht_pending</value>
                <value>decrc_pending</value>
                <value>wide_pending</value>
                <value>wide_split</value>
                <value>noautowrap</value>
                <value>scroll_region</value>
                <value>origin</value>
                <value>margins</value>
                <value>tabstops</value>
                <value>insert</value>
                <value>charset</value>
                <value>sgr</value>
                <value>altscreen</value>
                <value>scrollback</value>
                <value>cursor_hidden</value>
                <value>split_csi</value>
                <value>split_utf8</value>
            </arg>
        </run>
        <run>
            <script name="snapshot"><objective>A terminal restored from its own snapshot behaves like the live one.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
            </arg>
            <arg name="seq">
                <value>wrap_pending</value>
                <value>cub_pending</value>
                <value>cr_pending</value>
                <value>cha_pending</value>
                <value>bs_pending</value>
                <value>cbt_pending</value>
                <value>ht_pending</value>
                <value>decrc_pending</value>
                <value>wide_pending</value>
                <value>wide_split</value>
                <value>noautowrap</value>
                <value>scroll_region</value>
                <value>origin</value>
                <value>margins</value>
                <value>tabstops</value>
                <value>insert</value>
                <value>charset</value>
                <value>sgr</value>
                <value>altscreen</value>
                <value>scrollback</value>
                <value>cursor_hidden</value>
                <value>split_csi</value>
                <value>split_utf8</value>
            </arg>
        </run>
        <run>
            <script name="deepscroll"><objective>The scrollback keeps the newest 2000 lines, in order, however much was printed.</objective></script>
            <arg name="backend">
                <value>ghostty</value>
                <value>vterm</value>
            </arg>
        </run>
    </session>
</package>
